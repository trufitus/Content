[label,barrows_catacombs_open_door](int $side, loc $other)
if (p_finduid(uid) = false) return;
// TODO: check in a 5 tile radius (guess, not validated) for npcs
// TODO: find the other door at the opposite side, use loc_angle
def_loc $original_type = loc_type;
def_coord $original_coord = loc_coord;
def_int $original_angle = loc_angle;

def_coord $other_coord = ~barrows_other_door_coord($side, $original_angle, $original_coord);

if(.loc_find($other_coord, $other) = false) {
    mes("other door not found");
    return;
}
loc_add($original_coord, inviswall, 2, wall_straight, 2);
loc_add($original_coord, barrows_door_inactive_l, calc(($original_angle + 3) % 4), loc_shape, 2);

// spawn inviswalls
// delete locs
// spawn open doors barrows_door_inactive_r? barrows_door_inactive_l?
// move player through
// delete open doors
// spawn closed doors
// delete inviswalls

[proc,barrows_other_door_coord](int $side, int $angle, coord $base_coord)
if ($side = ^left) {
    switch_int($angle) {
        case ^loc_west : return movecoord(loc_coord, 0, 1, 0);
        case ^loc_north : return movecoord(loc_coord, 1, 0, 0);
        case ^loc_east : return movecoord(loc_coord, 0, -1, 0);
        case ^loc_south : return movecoord(loc_coord, -1, 0, 0);
        case default : error("Eep Eep! bad loc angle: <tostring($angle)>");
    }
} else {
    switch_int($angle) {
        case ^loc_west : return movecoord(loc_coord, 0, -1, 0);
        case ^loc_north : return movecoord(loc_coord, -1, 0, 0);
        case ^loc_east : return movecoord(loc_coord, 0, 1, 0);
        case ^loc_south : return movecoord(loc_coord, 1, 0, 0);
        case default : error("Eep Eep! bad loc angle: <tostring($angle)>");
    }
}
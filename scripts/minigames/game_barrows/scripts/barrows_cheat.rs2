[debugproc,barrowsnodmodel]
if_setmodel(barrows_overlay:ahrim, 6737);
mes("nodmodel");

[debugproc,barrowsnodnod]
if_setanim(barrows_overlay:ahrim, seq_2085);
mes("nodnod");

[debugproc,barrowsloot]
if (p_finduid(uid) = false) {
    return;
}
def_int $roll = 1;

while ($roll < 50) {
    ~barrows_loot;
    p_delay(1);
    $roll = calc($roll + 1);

    def_int $slot = 0;

    while ($slot < 8) {
        def_obj $obj = inv_getobj(inv, $slot);

        if ($obj ! null) {
            ~bank_deposit_request(inv, $obj, inv_getnum(inv, $slot), $slot);
        }
        $slot = calc($slot + 1);
    }
}
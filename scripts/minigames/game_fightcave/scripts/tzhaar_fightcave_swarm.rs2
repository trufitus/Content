[ai_queue3,_tzhaar_fightcave_swarm]
gosub(npc_death);

if (p_finduid(%npc_aggressive_player) = false) return;
def_npc_uid $self = npc_uid;

npc_huntall(^fightcave_center_coord, 63, 0);

while (npc_findnext = true) {
    if (nc_category(npc_type) = tzhaar_fightcave_swarm & $self ! npc_uid) return;
}
queue(tzhaar_fightcave_advance, 0, 0);

[ai_applayer2,tzhaar_fightcave_swarm_3a] @tzhaar_fightcave_swarm_3_attack;
[ai_opplayer2,tzhaar_fightcave_swarm_3a] npc_setmode(applayer2);

[ai_applayer2,tzhaar_fightcave_swarm_3b] @tzhaar_fightcave_swarm_3_attack;
[ai_opplayer2,tzhaar_fightcave_swarm_3b] npc_setmode(applayer2);

[label,tzhaar_fightcave_swarm_3_attack]
if (%npc_action_delay > map_clock) {
    npc_setmode(applayer2);
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}

if(npc_range(coord) < 2) {
    if (random(4) = 0) { // guessed
        @tzhaar_fightcave_swarm_3_range_attack;
    } else {
       ~npc_default_attack;
    }
} else {
    @tzhaar_fightcave_swarm_3_range_attack;
}

[label,tzhaar_fightcave_swarm_3_range_attack]
def_int $attack_roll = ~npc_ranged_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^ranged_style);
def_int $maxhit = ~npc_ranged_maxhit;

npc_anim(magmaquris_spine_attack, 0);
sound_synth(magmaquiris_spines, 0, 0);

%npc_action_delay = add(map_clock, npc_param(attackrate));
def_int $duration = ~player_projectile(movecoord(npc_coord, 1, 0, 1), coord, uid, tzhaar_spine_attack, 64, 31, 32, 16, 16, 32, 8);
def_int $damage = randominc($maxhit);

if (~check_protect_prayer(^ranged_style) = true) {
    $damage = 0;
}

if (randominc($attack_roll) > randominc($defence_roll)) {
    queue(combat_damage_player, calc($duration / 30), $damage);
    queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
    ~npc_set_attack_vars;
    return;
}
queue(combat_damage_player, calc($duration / 30), 0);
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;

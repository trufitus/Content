[ai_applayer2,tzhaar_fightcave_swarm_5a] @tzhaar_fightcave_swarm_5_attack;
[ai_opplayer2,tzhaar_fightcave_swarm_5a] npc_setmode(applayer2);

[ai_applayer2,tzhaar_fightcave_swarm_5b] @tzhaar_fightcave_swarm_5_attack;
[ai_opplayer2,tzhaar_fightcave_swarm_5b] npc_setmode(applayer2);

[label,tzhaar_fightcave_swarm_5_attack]
if (%npc_action_delay > map_clock) {
    npc_setmode(applayer2);
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}

if(npc_range(coord) < 2) {
    if (random(4) = 0) { // guessed
        @tzhaar_fightcave_swarm_5_mage_attack;
    } else {
       ~npc_default_attack;
    }
} else {
    @tzhaar_fightcave_swarm_5_mage_attack;
}

[label,tzhaar_fightcave_swarm_5_mage_attack]
def_int $attack_roll = ~npc_magic_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^magic_style);

npc_anim(igniferum_ranged, 0);
sound_synth(magmaquiris_attack, 0, 0);

%npc_action_delay = add(map_clock, npc_param(attackrate));
def_int $duration = ~player_projectile(movecoord(npc_coord, 2, 0, 2), coord, uid, tzhaar_fire_launch_travel, 128, 31, 28, 16, 24, 32, 8);
def_int $damage = randominc(55);

if (~check_protect_prayer(^magic_style) = true) {
    $damage = 0;
}

if (randominc($attack_roll) > randominc($defence_roll)) {
    spotanim_pl(tzhaar_fire_launch_impact, 0, $duration);
    queue(combat_damage_player, calc($duration / 30), $damage);
    queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
    ~npc_set_attack_vars;
    return;
}
spotanim_pl(tzhaar_fire_launch_impact, 0, $duration);
queue(combat_damage_player, calc($duration / 30), 0);
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;
